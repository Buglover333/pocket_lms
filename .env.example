# Настройки подключения к PostgreSQL (Docker)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# API (replace JWT_SECRET with a secret generated for your environment)
DATABASE_URL=postgresql://myuser:mypassword@127.0.0.1:5433/mydb
JWT_SECRET=
# Future frontend build directory; defaults to frontend/dist in this project.
# FRONTEND_DIR=/absolute/path/to/frontend/dist

# Optional private S3 storage. Use an IAM role or local AWS profile; do not commit real keys.
S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
# Set only for an S3-compatible storage provider; empty means AWS S3.
S3_ENDPOINT_URL=

# true for HTTPS deployment. Use false ONLY for local http://127.0.0.1 Swagger/demo.
AUTH_COOKIE_SECURE=true
